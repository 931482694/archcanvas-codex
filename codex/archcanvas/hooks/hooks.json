{
  "hooks": {
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/pre-tool.mjs\"", "timeout": 20 }] }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/post-edit.mjs\"",
            "timeout": 20,
            "statusMessage": "archcanvas：记下这次修改"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/prompt-submit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
